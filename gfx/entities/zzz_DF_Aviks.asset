entity = {

    name = "DF_Aviks_russian-btr_entity"

    pdxmesh = "DF_Aviks_russian-btr_mesh"

    default_state = "idle"

    state = {

        name = "idle"

        animation = "idle"

        animation_blend_time = 0.2

    }

    state = {

        name = "move"

        animation = "move"

        animation_blend_time = 0.2

    }

    state = {

        name = "retreat"

        animation = "retreat"

        animation_blend_time = 0.2

    }

    state = {

        name = "attack"

        animation = "attack"

        animation_blend_time = 0.2

        event = {

            time = 1.2

            node = "barrel"

            particle = "tank_attack_barrel_smoke_particle"

            keep_particle = no

        }

    }

    state = {

        name = "defend"

        animation = "defend"

        animation_blend_time = 0.2

        event = {

            time = 1.2

            node = "barrel"

            particle = "tank_attack_barrel_smoke_particle"

            keep_particle = no

        }

    }

    state = {

        name = "support_attack"

        animation = "support_attack"

        animation_blend_time = 0.2

        event = {

            time = 1.2

            node = "barrel"

            particle = "tank_attack_barrel_smoke_particle"

            keep_particle = no

        }

    }

    state = {

        name = "training"

        animation = "training"

        animation_blend_time = 0.2

    }

    scale = 1.0

}



